<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Newer ONNX Runtime releases upload usage telemetry from this provider; the app sends nothing anywhere. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
