# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to the project root.
# Create the key once with:
#   keytool -genkeypair -v -keystore tsunayomi-release.jks -alias tsunayomi -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and both passwords somewhere safe: updates must be signed with the same key forever.
storeFile=tsunayomi-release.jks
storePassword=
keyAlias=tsunayomi
keyPassword=
