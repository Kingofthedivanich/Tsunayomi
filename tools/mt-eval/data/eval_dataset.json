[
  {
    "id": "ja_001",
    "lang": "ja",
    "source_text": "魔物達が",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_002",
    "lang": "ja",
    "source_text": "向かわせた",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_003",
    "lang": "ja",
    "source_text": "王都に",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_004",
    "lang": "ja",
    "source_text": "まあのたち",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_005",
    "lang": "ja",
    "source_text": "おうと",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_006",
    "lang": "ja",
    "source_text": "大変です！！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_007",
    "lang": "ja",
    "source_text": "たい",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_008",
    "lang": "ja",
    "source_text": "ぜんめつ",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_009",
    "lang": "ja",
    "source_text": "しました！！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_010",
    "lang": "ja",
    "source_text": "どうして",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_011",
    "lang": "ja",
    "source_text": "そうなるのだ",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_012",
    "lang": "ja",
    "source_text": "ああああ！！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_013",
    "lang": "ja",
    "source_text": "思われたが",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_014",
    "lang": "ja",
    "source_text": "始めは胡散臭い",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_015",
    "lang": "ja",
    "source_text": "インチキ本かと",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_016",
    "lang": "ja",
    "source_text": "「魔術書」ー",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_017",
    "lang": "ja",
    "source_text": "発見された",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_018",
    "lang": "ja",
    "source_text": "我が領地で",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_019",
    "lang": "ja",
    "source_text": "そこに",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_020",
    "lang": "ja",
    "source_text": "一魔物を操る呪術」",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_021",
    "lang": "ja",
    "source_text": "書かれていた",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_022",
    "lang": "ja",
    "source_text": "遠跡主が遺した日誌から驚くべき事実が発覚した",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_023",
    "lang": "ja",
    "source_text": "なんと",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_024",
    "lang": "ja",
    "source_text": "その魔術書こそ",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_025",
    "lang": "ja",
    "source_text": "かの恐るべき”邪竜”を操った",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_026",
    "lang": "ja",
    "source_text": "本物の呪法を",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_027",
    "lang": "ja",
    "source_text": "しる",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_028",
    "lang": "ja",
    "source_text": "だったのだ！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_029",
    "lang": "ja",
    "source_text": "記した本",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_030",
    "lang": "ja",
    "source_text": "ほんものじゃほう",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_031",
    "lang": "ja",
    "source_text": "建国伝説に名を残す",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_032",
    "lang": "ja",
    "source_text": "驚きの事実！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_033",
    "lang": "ja",
    "source_text": "伝説の邪竜が実は人の手によって操られていたという",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_034",
    "lang": "ja",
    "source_text": "出来るという事！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_035",
    "lang": "ja",
    "source_text": "支配する事が",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_036",
    "lang": "ja",
    "source_text": "我等もまた邪竜を",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_037",
    "lang": "ja",
    "source_text": "本当なら",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_038",
    "lang": "ja",
    "source_text": "ほんとう",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_039",
    "lang": "ja",
    "source_text": "それが",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_040",
    "lang": "ja",
    "source_text": "”アレ”だ！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_041",
    "lang": "ja",
    "source_text": "こうなったら",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_042",
    "lang": "ja",
    "source_text": "４月２８日（金）朝行していたのか！？離室です！",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_043",
    "lang": "ja",
    "source_text": "上海に切り札を",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_044",
    "lang": "ja",
    "source_text": "あらかじめ",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_045",
    "lang": "ja",
    "source_text": "動きを予測して",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_046",
    "lang": "ja",
    "source_text": "まさか敵は我々の",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_047",
    "lang": "ja",
    "source_text": "アレを使うモーシロモノですよ！？",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_048",
    "lang": "ja",
    "source_text": "のですか！？",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_049",
    "lang": "ja",
    "source_text": "．．．．．．まさかヤツを使う",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ja_050",
    "lang": "ja",
    "source_text": "夜に制御出来ない",
    "source_manga": "Nido Tensei (Klz9)"
  },
  {
    "id": "ko_001",
    "lang": "ko",
    "source_text": "두공, 자네의말대로일세.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_002",
    "lang": "ko",
    "source_text": "육감도 의히지못한 놈이 오대악인의재주를 빼앗다니.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_003",
    "lang": "ko",
    "source_text": "착, 자네사위 말인데.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_004",
    "lang": "ko",
    "source_text": "운 하나만큼은기가 막힐 정도로타고났군.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_005",
    "lang": "ko",
    "source_text": "그나저나",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_006",
    "lang": "ko",
    "source_text": "또 그놈이야기인가?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_007",
    "lang": "ko",
    "source_text": "그 도둑놈이그리 좋으면 자네사위 하시게.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_008",
    "lang": "ko",
    "source_text": "이번에 온 녀석들은조금 까다롭겠구나.어찌할 테나냐?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_009",
    "lang": "ko",
    "source_text": "허허, 자네도마음에 들어하면서말 한번 참 못나게하는군.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_010",
    "lang": "ko",
    "source_text": "다른게 아니고,내가 풍수지리나역술에도 재주가좀 있지 않은가?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_011",
    "lang": "ko",
    "source_text": "수는 다섯.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_012",
    "lang": "ko",
    "source_text": "자네 사위의관상이 참 특이해.천기를 읽을 수 없을만큼기이한 상이야.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_013",
    "lang": "ko",
    "source_text": "초결정이 한명.나머지는 절정.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_014",
    "lang": "ko",
    "source_text": "자네 사위의 생은아마도 기상천외한 일이수도 없이 벌어질 걸세.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_015",
    "lang": "ko",
    "source_text": "전부 끄집어되겠느냐?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_016",
    "lang": "ko",
    "source_text": "내어주면",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_017",
    "lang": "ko",
    "source_text": "아노.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_018",
    "lang": "ko",
    "source_text": "제가 하겠습니다.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_019",
    "lang": "ko",
    "source_text": "떠나진 않네?그래도 곁에서지켜보겠단 건가?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_020",
    "lang": "ko",
    "source_text": "어떻게 하니보겠다는 거겠지.그리고 부탁이 있다했었으니까",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_021",
    "lang": "ko",
    "source_text": "그럼 어디철수련의 지식을최대한 써 볼까?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_022",
    "lang": "ko",
    "source_text": "이곳으로 다가오는인기척 정도는 알 수있겠지?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_023",
    "lang": "ko",
    "source_text": "네 수양아들들이도착했군.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_024",
    "lang": "ko",
    "source_text": "잘 키웠다만당신의 자식들이 나를감당할 수 있을까?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_025",
    "lang": "ko",
    "source_text": "모습을드러내라.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_026",
    "lang": "ko",
    "source_text": "당신들의 에미가죽도록 내버려 둘참이냐?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_027",
    "lang": "ko",
    "source_text": "원작 한중월야 각색 김두루미 그림 티아이",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_028",
    "lang": "ko",
    "source_text": "그대가 당대혈마구려.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_029",
    "lang": "ko",
    "source_text": "그 명성은 익히들었소이다.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_030",
    "lang": "ko",
    "source_text": "그대는 조음사마의맏형인 철음유겠구려.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_031",
    "lang": "ko",
    "source_text": "어, 어떻게 30년 전별호와 이름을",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_032",
    "lang": "ko",
    "source_text": "조음사마?그게 뭐야?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_033",
    "lang": "ko",
    "source_text": "철수련의 기억을읽으면서 이들의정제를 알게 되었어.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_034",
    "lang": "ko",
    "source_text": "조음사마.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_035",
    "lang": "ko",
    "source_text": "악명을 떨졌던네 형제.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_036",
    "lang": "ko",
    "source_text": "인악면 사건처럼철수련의 명을 받아젊은 여인들을 납치했던놈들이야",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_037",
    "lang": "ko",
    "source_text": "무한제일검 백향묵이현역으로 명성을 떨치던당시와 활동이 겹쳐서",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_038",
    "lang": "ko",
    "source_text": "그에게 당하고자취를 감추었지만",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_039",
    "lang": "ko",
    "source_text": "누구도 저들이악심파과가 키운 자들이라아는 자가 없었어.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_040",
    "lang": "ko",
    "source_text": "그럼 그나마어려보이는 저한 명은?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_041",
    "lang": "ko",
    "source_text": "나중에 거뒤들인수양 자식이야.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_042",
    "lang": "ko",
    "source_text": "양정을 비롯해그날 영영이네를습격했던 놈들과같은 기수네.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_043",
    "lang": "ko",
    "source_text": "혈마여, 어머니를놓아주시오. 그러면그냥 돌아가도록하리다.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_044",
    "lang": "ko",
    "source_text": "그냥 돌아가지않으면 어쩔 참이오?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_045",
    "lang": "ko",
    "source_text": "막내야.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_046",
    "lang": "ko",
    "source_text": "반시()들을조종하는 방을.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_047",
    "lang": "ko",
    "source_text": "이걸로 혈마를압박한다",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_048",
    "lang": "ko",
    "source_text": "혼란을 틈어머니를 챙행길 수있을 것이다.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_049",
    "lang": "ko",
    "source_text": "한데 왜꿈쩍도 않는 거지?",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "ko_050",
    "lang": "ko",
    "source_text": "고작 이것들을 믿고그런 말을 했군.",
    "source_manga": "절대검감 (Naver Webtoon)"
  },
  {
    "id": "zh_001",
    "lang": "zh",
    "source_text": "2h简去以魔道具,",
    "source_manga": "被赶出了家门 (Manhuagui)"
  },
  {
    "id": "zh_002",
    "lang": "zh",
    "source_text": "家迫出丁加れ",
    "source_manga": "被赶出了家门 (Manhuagui)"
  },
  {
    "id": "zh_003",
