  "translations": [
    {
      "id": "ja_001",
      "lang": "ja",
      "source_text": "魔物達が",
      "nllb_en": "The witches.",
      "nllb_ru": "Я знаю, что они могут.",
      "latency_en_sec": 2.1977,
      "latency_ru_sec": 0.2916
    },
    {
      "id": "ja_002",
      "lang": "ja",
      "source_text": "向かわせた",
      "nllb_en": "I made him go.",
      "nllb_ru": "Я выдвинул его.",
      "latency_en_sec": 0.2313,
      "latency_ru_sec": 0.2603
    },
    {
      "id": "ja_003",
      "lang": "ja",
      "source_text": "王都に",
      "nllb_en": "To the capital.",
      "nllb_ru": "В столицу.",
      "latency_en_sec": 0.2245,
      "latency_ru_sec": 0.2084
    },
    {
      "id": "ja_004",
      "lang": "ja",
      "source_text": "まあのたち",
      "nllb_en": "Oh, my God.",
      "nllb_ru": "- Да, это они.",
      "latency_en_sec": 0.2338,
      "latency_ru_sec": 0.2686
    },
    {
      "id": "ja_005",
      "lang": "ja",
      "source_text": "おうと",
      "nllb_en": "I'm going to go with you.",
      "nllb_ru": "- Да, ещё.",
      "latency_en_sec": 0.362,
      "latency_ru_sec": 0.2324
    },
    {
      "id": "ja_006",
      "lang": "ja",
      "source_text": "大変です！！",
      "nllb_en": "It's a big deal!",
      "nllb_ru": "Это очень сложно!",
      "latency_en_sec": 0.3341,
      "latency_ru_sec": 0.2598
    },
    {
      "id": "ja_007",
      "lang": "ja",
      "source_text": "たい",
      "nllb_en": "I'm going to.",
      "nllb_ru": "- Да, это так.",
      "latency_en_sec": 0.2867,
      "latency_ru_sec": 0.2851
    },
    {
      "id": "ja_008",
      "lang": "ja",
      "source_text": "ぜんめつ",
      "nllb_en": "It's a pain.",
      "nllb_ru": "- Я не могу.",
      "latency_en_sec": 0.2656,
      "latency_ru_sec": 0.2579
    },
    {
      "id": "ja_009",
      "lang": "ja",
      "source_text": "しました！！",
      "nllb_en": "I did it!",
      "nllb_ru": "Я сделал это!",
      "latency_en_sec": 0.2076,
      "latency_ru_sec": 0.2196
    },
    {
      "id": "ja_010",
      "lang": "ja",
      "source_text": "どうして",
      "nllb_en": "Why?",
      "nllb_ru": "Почему?",
      "latency_en_sec": 0.1687,
      "latency_ru_sec": 0.1571
    },
    {
      "id": "ja_011",
      "lang": "ja",
      "source_text": "そうなるのだ",
      "nllb_en": "It's going to happen.",
      "nllb_ru": "Это так.",
      "latency_en_sec": 0.3091,
      "latency_ru_sec": 0.1777
    },
    {
      "id": "ja_012",
      "lang": "ja",
      "source_text": "ああああ！！",
      "nllb_en": "Oh, yeah!",
      "nllb_ru": "Да, да, да, да!",
      "latency_en_sec": 0.2198,
      "latency_ru_sec": 0.3626
    },
    {
      "id": "ja_013",
      "lang": "ja",
      "source_text": "思われたが",
      "nllb_en": "I thought so.",
      "nllb_ru": "Я думал, что это так.",
      "latency_en_sec": 0.2017,
      "latency_ru_sec": 0.2889
    },
    {
      "id": "ja_014",
      "lang": "ja",
      "source_text": "始めは胡散臭い",
      "nllb_en": "It's a mess at first.",
      "nllb_ru": "Сначала она не очень хороша.",
      "latency_en_sec": 0.3253,
      "latency_ru_sec": 0.3778
    },
    {
      "id": "ja_015",
      "lang": "ja",
      "source_text": "インチキ本かと",
      "nllb_en": "I thought it was a book of ink.",
      "nllb_ru": "Я думаю, это была инки.",
      "latency_en_sec": 0.3589,
      "latency_ru_sec": 0.3272
    },
    {
      "id": "ja_016",
      "lang": "ja",
      "source_text": "「魔術書」ー",
      "nllb_en": "The magic book.",
      "nllb_ru": "\"Магическая книга\".",
      "latency_en_sec": 0.2029,
      "latency_ru_sec": 0.2599
    },
    {
      "id": "ja_017",
      "lang": "ja",
      "source_text": "発見された",
      "nllb_en": "They found it.",
      "nllb_ru": "Они нашли.",
      "latency_en_sec": 0.2068,
      "latency_ru_sec": 0.1776
    },
    {
      "id": "ja_018",
      "lang": "ja",
      "source_text": "我が領地で",
      "nllb_en": "It's my territory.",
      "nllb_ru": "На моей территории.",
      "latency_en_sec": 0.2731,
      "latency_ru_sec": 0.2069
    },
    {
      "id": "ja_019",
      "lang": "ja",
      "source_text": "そこに",
      "nllb_en": "There you go.",
      "nllb_ru": "Там.",
      "latency_en_sec": 0.2078,
      "latency_ru_sec": 0.1467
    },
    {
      "id": "ja_020",
      "lang": "ja",
      "source_text": "一魔物を操る呪術」",
      "nllb_en": "\"A magic spell that can manipulate a demon\".",
      "nllb_ru": "\"Волшебство, которое управляет демоном\".",
      "latency_en_sec": 0.4647,
      "latency_ru_sec": 0.471
    },
    {
      "id": "ja_021",
      "lang": "ja",
      "source_text": "書かれていた",
      "nllb_en": "It was written.",
      "nllb_ru": "Это было написано.",
      "latency_en_sec": 0.207,
      "latency_ru_sec": 0.2356
    },
    {
      "id": "ja_022",
      "lang": "ja",
      "source_text": "遠跡主が遺した日誌から驚くべき事実が発覚した",
      "nllb_en": "I found a surprising fact in the logs that the expedition owner left behind.",
      "nllb_ru": "В дневнике, оставленном экспедитором, мы обнаружили удивительные факты.",
      "latency_en_sec": 0.6311,
      "latency_ru_sec": 0.7169
    },
    {
      "id": "ja_023",
      "lang": "ja",
      "source_text": "なんと",
      "nllb_en": "What?",
      "nllb_ru": "Что за хрен.",
      "latency_en_sec": 0.1472,
      "latency_ru_sec": 0.2371
    },
    {
      "id": "ja_024",
      "lang": "ja",
      "source_text": "その魔術書こそ",
      "nllb_en": "It's the magic book.",
      "nllb_ru": "Это волшебная книга.",
      "latency_en_sec": 0.3184,
      "latency_ru_sec": 0.3131
    },
    {
      "id": "ja_025",
      "lang": "ja",
      "source_text": "かの恐るべき”邪竜”を操った",
      "nllb_en": "I was playing that dreadful dragonfly.",
      "nllb_ru": "Я управляю этой страшной, злой, трогательной птицей.",
      "latency_en_sec": 0.3903,
      "latency_ru_sec": 0.5932
    },
    {
      "id": "ja_026",
      "lang": "ja",
      "source_text": "本物の呪法を",
      "nllb_en": "The real curse.",
      "nllb_ru": "Это настоящий проклятие.",
      "latency_en_sec": 0.2451,
      "latency_ru_sec": 0.3177
    },
    {
      "id": "ja_027",
      "lang": "ja",
      "source_text": "しる",
      "nllb_en": "I will.",
      "nllb_ru": "Я сделаю это.",
      "latency_en_sec": 0.1766,
      "latency_ru_sec": 0.2336
    },
    {
      "id": "ja_028",
      "lang": "ja",
      "source_text": "だったのだ！",
      "nllb_en": "It was!",
      "nllb_ru": "Это было!",
      "latency_en_sec": 0.1795,
      "latency_ru_sec": 0.1766
    },
    {
      "id": "ja_029",
      "lang": "ja",
      "source_text": "記した本",
      "nllb_en": "The book I'm writing.",
      "nllb_ru": "Книги, которые я писал.",
      "latency_en_sec": 0.2908,
      "latency_ru_sec": 0.3845
    },
    {
      "id": "ja_030",
      "lang": "ja",
      "source_text": "ほんものじゃほう",
      "nllb_en": "It's not real.",
      "nllb_ru": "Это не так.",
      "latency_en_sec": 0.2723,
      "latency_ru_sec": 0.2199
    },
    {
      "id": "ja_031",
      "lang": "ja",
      "source_text": "建国伝説に名を残す",
      "nllb_en": "I'll leave my name in the legend of the founding fathers.",
      "nllb_ru": "Я останусь легендой о его создании.",
      "latency_en_sec": 0.6088,
      "latency_ru_sec": 0.4695
    },
    {
      "id": "ja_032",
      "lang": "ja",
      "source_text": "驚きの事実！",
      "nllb_en": "That's a surprising fact!",
      "nllb_ru": "Это удивительно!",
      "latency_en_sec": 0.4056,
      "latency_ru_sec": 0.2596
    },
    {
      "id": "ja_033",
      "lang": "ja",
      "source_text": "伝説の邪竜が実は人の手によって操られていたという",
      "nllb_en": "The legendary evil dragon was actually controlled by human hands.",
      "nllb_ru": "И я не могу сказать, что это не так.",
      "latency_en_sec": 0.593,
      "latency_ru_sec": 0.5483
    },
    {
      "id": "ja_034",
      "lang": "ja",
      "source_text": "出来るという事！",
      "nllb_en": "I can do it!",
      "nllb_ru": "Я знаю, что могу!",
      "latency_en_sec": 0.2825,
      "latency_ru_sec": 0.3233
    },
    {
      "id": "ja_035",
      "lang": "ja",
      "source_text": "支配する事が",
      "nllb_en": "It's the control.",
      "nllb_ru": "Это не просто о том, что мы контролируем.",
      "latency_en_sec": 0.3424,
      "latency_ru_sec": 0.565
    },
    {
      "id": "ja_036",
      "lang": "ja",
      "source_text": "我等もまた邪竜を",
      "nllb_en": "We're also the evil dragons.",
      "nllb_ru": "Мы тоже были злыми драконами.",
      "latency_en_sec": 0.4453,
      "latency_ru_sec": 0.4235
    },
    {
      "id": "ja_037",
      "lang": "ja",
      "source_text": "本当なら",
      "nllb_en": "If it's true,",
      "nllb_ru": "Если это правда,",
      "latency_en_sec": 0.3332,
      "latency_ru_sec": 0.2588
    },
    {
      "id": "ja_038",
      "lang": "ja",
      "source_text": "ほんとう",
      "nllb_en": "I really do.",
      "nllb_ru": "- Да, это правда.",
      "latency_en_sec": 0.2854,
      "latency_ru_sec": 0.3519
    },
    {
      "id": "ja_039",
      "lang": "ja",
      "source_text": "それが",
      "nllb_en": "That's what it is.",
      "nllb_ru": "Это так.",
      "latency_en_sec": 0.3546,
      "latency_ru_sec": 0.2135
    },
    {
      "id": "ja_040",
      "lang": "ja",
      "source_text": "”アレ”だ！",
      "nllb_en": "It's a fucking thing!",
      "nllb_ru": "Это - алерея!",
      "latency_en_sec": 0.3521,
      "latency_ru_sec": 0.3378
    },
    {
      "id": "ja_041",
      "lang": "ja",
      "source_text": "こうなったら",
      "nllb_en": "If this happens,",
      "nllb_ru": "Если это произойдет,",
      "latency_en_sec": 0.2624,
      "latency_ru_sec": 0.3013
    },
    {
      "id": "ja_042",
      "lang": "ja",
      "source_text": "４月２８日（金）朝行していたのか！？離室です！",
      "nllb_en": "Did you go out on Friday morning, April 28?",
      "nllb_ru": "Вы были в пятницу, 28 апреля, утром?",
      "latency_en_sec": 0.5521,
      "latency_ru_sec": 0.6032
    },
    {
      "id": "ja_043",
      "lang": "ja",
      "source_text": "上海に切り札を",
      "nllb_en": "I'm going to Shanghai.",
      "nllb_ru": "Я хочу, чтобы ты отрезал мне знаки в Шанхае.",
      "latency_en_sec": 0.3771,
      "latency_ru_sec": 0.7456
    },
    {
      "id": "ja_044",
      "lang": "ja",
      "source_text": "あらかじめ",
      "nllb_en": "I'll take it from there.",
      "nllb_ru": "- Я не могу.",
      "latency_en_sec": 0.4174,
      "latency_ru_sec": 0.2917
    },
    {
      "id": "ja_045",
      "lang": "ja",
      "source_text": "動きを予測して",
      "nllb_en": "And then we can predict the movement.",
      "nllb_ru": "И мы можем предсказать, что будет происходить.",
      "latency_en_sec": 0.4615,
      "latency_ru_sec": 0.6002
    },
    {
      "id": "ja_046",
      "lang": "ja",
      "source_text": "まさか敵は我々の",
      "nllb_en": "No, the enemy is ours.",
      "nllb_ru": "Мы не против.",
      "latency_en_sec": 0.3616,
      "latency_ru_sec": 0.2557
    },
    {
      "id": "ja_047",
      "lang": "ja",
      "source_text": "アレを使うモーシロモノですよ！？",
      "nllb_en": "I'm using the moshilos.",
      "nllb_ru": "Я использую мосиро!",
      "latency_en_sec": 0.4596,
      "latency_ru_sec": 0.3921
    },
    {
      "id": "ja_048",
      "lang": "ja",
      "source_text": "のですか！？",
      "nllb_en": "What?",
      "nllb_ru": "Что?",
      "latency_en_sec": 0.1985,
      "latency_ru_sec": 0.1983
    },
    {
      "id": "ja_049",
      "lang": "ja",
      "source_text": "．．．．．．まさかヤツを使う",
      "nllb_en": "I'm not using him.",
      "nllb_ru": "Я не хочу, чтобы он...",
      "latency_en_sec": 0.4023,
      "latency_ru_sec": 0.3623
    },
    {
      "id": "ja_050",
      "lang": "ja",
      "source_text": "夜に制御出来ない",
      "nllb_en": "I can't control it at night.",
      "nllb_ru": "Ночь не поддается контролю.",
      "latency_en_sec": 0.4579,
      "latency_ru_sec": 0.4268
    },
    {
      "id": "ko_001",
      "lang": "ko",
      "source_text": "두공, 자네의말대로일세.",
      "nllb_en": "Dude, just like you said.",
      "nllb_ru": "Дуэк, как ты сказал.",
      "latency_en_sec": 0.4297,
      "latency_ru_sec": 0.4105
    },
    {
      "id": "ko_002",
      "lang": "ko",
      "source_text": "육감도 의히지못한 놈이 오대악인의재주를 빼앗다니.",
      "nllb_en": "A man of no sense takes away the kingdom of the wicked.",
      "nllb_ru": "Неверный человек отнимает власть над злым.",
      "latency_en_sec": 0.5967,
      "latency_ru_sec": 0.6368
    },
    {
      "id": "ko_003",
      "lang": "ko",
      "source_text": "착, 자네사위 말인데.",
      "nllb_en": "Good, for your sake.",
      "nllb_ru": "Я говорю тебе, хорошо.",
      "latency_en_sec": 0.3382,
      "latency_ru_sec": 0.3445
    },
    {
      "id": "ko_004",
      "lang": "ko",
      "source_text": "운 하나만큼은기가 막힐 정도로타고났군.",
      "nllb_en": "I'm so tired of a car that it's blocked.",
      "nllb_ru": "Я застрял, чтобы остановить тебя.",
      "latency_en_sec": 0.7235,
      "latency_ru_sec": 0.5105
    },
    {
      "id": "ko_005",
      "lang": "ko",
      "source_text": "그나저나",
      "nllb_en": "I'm not.",
      "nllb_ru": "- Я не знаю.",
      "latency_en_sec": 0.3025,
      "latency_ru_sec": 0.3542
    },
    {
      "id": "ko_006",
      "lang": "ko",
      "source_text": "또 그놈이야기인가?",
      "nllb_en": "Is that him again?",
      "nllb_ru": "Это о нем?",
      "latency_en_sec": 0.3129,
      "latency_ru_sec": 0.2676
    },
    {
      "id": "ko_007",
      "lang": "ko",
      "source_text": "그 도둑놈이그리 좋으면 자네사위 하시게.",
      "nllb_en": "If that thief likes you, he'll do it for you.",
      "nllb_ru": "Если этот вор так любит тебя, он сделает это ради тебя.",
      "latency_en_sec": 0.6622,
      "latency_ru_sec": 0.7216
    },
    {
      "id": "ko_008",
      "lang": "ko",
      "source_text": "이번에 온 녀석들은조금 까다롭겠구나.어찌할 테나냐?",
      "nllb_en": "I'm gonna have to ask them to come in a little harder this time.",
      "nllb_ru": "Они будут немного сложными.",
      "latency_en_sec": 0.7627,
      "latency_ru_sec": 0.3937
    },
    {
      "id": "ko_009",
      "lang": "ko",
      "source_text": "허허, 자네도마음에 들어하면서말 한번 참 못나게하는군.",
      "nllb_en": "You're a little bit of a bitch to me.",
      "nllb_ru": "Ты тоже не можешь говорить, когда слышишь.",
      "latency_en_sec": 0.5713,
      "latency_ru_sec": 0.5451
    },
    {
      "id": "ko_010",
      "lang": "ko",
      "source_text": "다른게 아니고,내가 풍수지리나역술에도 재주가좀 있지 않은가?",
      "nllb_en": "I'm not the only one who has any knowledge of the water and the trade.",
      "nllb_ru": "Я не обладаю в этом никакой влажностью?",
      "latency_en_sec": 0.8003,
      "latency_ru_sec": 0.6163
    },
    {
      "id": "ko_011",
      "lang": "ko",
      "source_text": "수는 다섯.",
      "nllb_en": "Number five.",
      "nllb_ru": "Пять.",
      "latency_en_sec": 0.2366,
      "latency_ru_sec": 0.2393
    },
    {
      "id": "ko_012",
      "lang": "ko",
      "source_text": "자네 사위의관상이 참 특이해.천기를 읽을 수 없을만큼기이한 상이야.",
      "nllb_en": "Your vision is so strange, it's so strange that you can't read the sky.",
      "nllb_ru": "Ты не можешь читать небо.",
      "latency_en_sec": 0.9076,
      "latency_ru_sec": 0.3765
    },
    {
      "id": "ko_013",
      "lang": "ko",
      "source_text": "초결정이 한명.나머지는 절정.",
      "nllb_en": "One over-decision, and the name is perfect.",
      "nllb_ru": "Это одно решение.",
      "latency_en_sec": 0.5555,
      "latency_ru_sec": 0.2807
    },
    {
      "id": "ko_014",
      "lang": "ko",
      "source_text": "자네 사위의 생은아마도 기상천외한 일이수도 없이 벌어질 걸세.",
      "nllb_en": "Your brother's life will probably be without any supernatural events.",
      "nllb_ru": "Твоя жизнь может быть без каких-либо необычных явлений.",
      "latency_en_sec": 0.7358,
      "latency_ru_sec": 0.73
    },
    {
      "id": "ko_015",
      "lang": "ko",
      "source_text": "전부 끄집어되겠느냐?",
      "nllb_en": "Can we get them all out?",
      "nllb_ru": "Вы можете все вытащить?",
      "latency_en_sec": 0.4135,
      "latency_ru_sec": 0.4327
    },
    {
