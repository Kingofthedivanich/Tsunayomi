      "latency_en_sec": 0.8218,
      "latency_ru_sec": 1.0822
    },
    {
      "id": "zh_035",
      "lang": "zh",
      "source_text": "為度?",
      "nllb_en": "Why?",
      "nllb_ru": "Почему?",
      "latency_en_sec": 0.236,
      "latency_ru_sec": 0.2229
    },
