      "nllb_ru": "Что же случилось?",
      "latency_en_sec": 0.2608,
      "latency_ru_sec": 0.2961
    },
    {
      "id": "zh_032",
      "lang": "zh",
      "source_text": "大小姐她…大小姐她…",
      "nllb_en": "Miss She... Miss She...",
      "nllb_ru": "Мисс она... мисс она...",
      "latency_en_sec": 0.3757,
      "latency_ru_sec": 0.4923
    },
    {
      "id": "zh_033",
      "lang": "zh",
      "source_text": "|總而言 則",
      "nllb_en": "And that's the whole point.",
      "nllb_ru": "В общем, это так.",
